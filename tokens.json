{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Warm editorial tailoring. A refined Holden boutique that reads as trustworthy local retail, never as a template.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.129,
          0.102,
          0.086
        ],
        "hex": "#211a16"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.459,
          0.408,
          0.369
        ],
        "hex": "#75685e"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.478,
          0.18,
          0.165
        ],
        "hex": "#7a2e2a"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.969,
          0.941,
          0.902
        ],
        "hex": "#f7f0e6"
      }
    },
    "paper": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.973,
          0.933
        ],
        "hex": "#fff8ee"
      }
    },
    "white": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "charcoal": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.169,
          0.129,
          0.11
        ],
        "hex": "#2b211c"
      }
    },
    "walnut": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.361,
          0.231,
          0.184
        ],
        "hex": "#5c3b2f"
      }
    },
    "brass": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.663,
          0.478,
          0.263
        ],
        "hex": "#a97a43"
      }
    },
    "brassSoft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.886,
          0.784,
          0.624
        ],
        "hex": "#e2c89f"
      }
    },
    "line": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.875,
          0.82,
          0.749
        ],
        "hex": "#dfd1bf"
      }
    },
    "secondaryOnDark": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.235,
          0.2,
          0.18
        ],
        "hex": "#3c332e"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 18,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Newsreader",
        "fontSize": {
          "value": 4.875,
          "unit": "rem"
        },
        "fontWeight": 650,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Newsreader",
        "fontSize": {
          "value": 3.5,
          "unit": "rem"
        },
        "fontWeight": 650,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Sans",
        "fontSize": {
          "value": 1.375,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Sans",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "eyebrow": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Sans",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "blockquote": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Newsreader",
        "fontSize": {
          "value": 1.5,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    }
  }
}
